    await loadSubjects();

    updateDashboard();
}


async function deleteSubject(code) {

    if (!confirm(
        "Delete this subject?"
    )) {

        return;
    }


    await fetch(
        "/api/subjects/" + code,
        {
            method: "DELETE"
        }
    );


    await loadSubjects();

