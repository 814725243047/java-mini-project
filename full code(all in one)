    // =========================================================
    // LOGIN API
    // =========================================================

    static void login(HttpExchange exchange)
            throws IOException {

        if (!exchange.getRequestMethod()
                .equalsIgnoreCase("POST")) {

            sendResponse(
                    exchange,
                    "{\"success\":false}",
                    "application/json"
            );

            return;
        }


        String body =
                readBody(exchange);


        String username =
                getValue(body, "username");

        String password =
                getValue(body, "password");


        boolean valid =
                username.equals("admin")
                        &&
                password.equals("admin123");


        String json;


        if (valid) {

            json =
                    """
                    {
                        "success": true,
                        "message": "Login successful"
                    }
                    """;

        } else {

            json =
                    """
                    {
                        "success": false,
                        "message": "Invalid username or password"
                    }
                    """;
        }


        sendResponse(
                exchange,
                json,
                "application/json"
        );
    }


    // =========================================================
    // STUDENT API
    // =========================================================

    static void studentAPI(HttpExchange exchange)
            throws IOException {

        String method =
                exchange.getRequestMethod();


        if (method.equalsIgnoreCase("GET")) {

            StringBuilder json =
                    new StringBuilder("[");


            for (int i = 0;
                 i < students.size();
                 i++) {

                Student s =
                        students.get(i);


                json.append(
                        "{"
                                + "\"id\":\""
                                + escape(s.id)
                                + "\","

                                + "\"name\":\""
                                + escape(s.name)
                                + "\","

                                + "\"department\":\""
                                + escape(s.department)
                                + "\","

                                + "\"className\":\""
                                + escape(s.className)
                                + "\","

                                + "\"phone\":\""
                                + escape(s.phone)
                                + "\""
                                + "}"
                );


                if (i < students.size() - 1) {

                    json.append(",");
                }
            }


            json.append("]");


            sendResponse(
                    exchange,
                    json.toString(),
                    "application/json"
            );

            return;
        }


        if (method.equalsIgnoreCase("POST")) {

            String body =
                    readBody(exchange);


            Student student =
                    new Student(

                            getValue(body, "id"),

                            getValue(body, "name"),

                            getValue(body, "department"),

                            getValue(body, "className"),

                            getValue(body, "phone")
                    );


            students.add(student);


            sendResponse(
                    exchange,
                    "{\"success\":true}",
                    "application/json"
            );

            return;
        }


        if (method.equalsIgnoreCase("DELETE")) {

            String path =
                    exchange.getRequestURI()
                            .getPath();


            String id =
                    path.substring(
                            path.lastIndexOf("/") + 1
                    );


            students.removeIf(
                    s -> s.id.equals(id)
            );


            sendResponse(
                    exchange,
                    "{\"success\":true}",
                    "application/json"
            );
        }
    }


