    // ==============================
    // TEACHER MENU
    // ==============================

    private void showTeacherMenu(
            String teacherName) {

        getContentPane().removeAll();

        setTitle("Teacher");

        JPanel panel =
                new JPanel();

        panel.setLayout(null);

        JLabel title =
                new JLabel(
                        "WELCOME " + teacherName,
                        SwingConstants.CENTER
                );

        title.setFont(
                new Font(
                        "Arial",
                        Font.BOLD,
                        20
                )
        );

        title.setBounds(
                80, 30, 340, 40
        );

        JButton attendanceButton =
                new JButton("Take Attendance");

        attendanceButton.setBounds(
                130, 110, 240, 45
        );

        JButton reportButton =
                new JButton("Generate Report");

        reportButton.setBounds(
                130, 170, 240, 45
        );

        JButton logoutButton =
                new JButton("Logout");

        logoutButton.setBounds(
                130, 230, 240, 45
        );

