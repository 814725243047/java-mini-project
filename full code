        JLabel title =
                new JLabel(
                        "ADMINISTRATOR",
                        SwingConstants.CENTER
                );

        title.setFont(
                new Font(
                        "Arial",
                        Font.BOLD,
                        22
                )
        );

        title.setBounds(
                100, 30, 300, 40
        );

        JButton addStudent =
                new JButton("Add Student");

        addStudent.setBounds(
                140, 100, 220, 45
        );

        JButton addTeacher =
                new JButton("Add Teacher");

        addTeacher.setBounds(
                140, 160, 220, 45
        );

        JButton report =
                new JButton("Attendance Report");

        report.setBounds(
                140, 220, 220, 45
        );

        JButton logout =
                new JButton("Logout");

        logout.setBounds(
                140, 280, 220, 45
        );

        panel.add(title);
        panel.add(addStudent);
