import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public class AttendanceManagementSystem extends JFrame {

    // ==============================
    // DATA
    // ==============================

    static class Student {
        String name;
        String semester;

        Student(String name, String semester) {
            this.name = name;
            this.semester = semester;
        }
    }

    static class Teacher {
        String name;
        String username;
        String password;

        Teacher(String name, String username, String password) {
            this.name = name;
            this.username = username;
            this.password = password;
        }
    }

    static class Attendance {
        String student;
        String status;

        Attendance(String student, String status) {
            this.student = student;
            this.status = status;
        }
    }

    // Student list
    static List<Student> students = new ArrayList<>();

    // Teacher list
    static List<Teacher> teachers = new ArrayList<>();

    // Subject -> Attendance list
    static Map<String, List<Attendance>> attendance =
            new HashMap<>();

    static String[] subjects = {
            "Maths",
            "Physics",
            "Chemistry"
    };

    // ==============================
    // CONSTRUCTOR
    // ==============================

    public AttendanceManagementSystem() {

        // Sample students
        students.add(new Student("Student1", "2"));
        students.add(new Student("Student2", "2"));
        students.add(new Student("Student3", "3"));
        students.add(new Student("Student4", "4"));

        // Sample teachers
        teachers.add(
                new Teacher("Teacher 1", "teacher1", "tkey1")
        );

        teachers.add(
                new Teacher("Teacher 2", "teacher2", "tkey2")
        );

        // Create attendance lists
        for (String subject : subjects) {
            attendance.put(subject, new ArrayList<>());
        }

        showLogin();
    }

    // ==============================
    // LOGIN SCREEN
    // ==============================

    private void showLogin() {

        getContentPane().removeAll();

        setTitle("Attendance Management System");
        setSize(500, 400);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

        JPanel mainPanel = new JPanel();
        mainPanel.setLayout(null);

        JLabel title = new JLabel(
                "ATTENDANCE MANAGEMENT SYSTEM",
                SwingConstants.CENTER
        );

        title.setFont(
                new Font("Arial", Font.BOLD, 20)
        );

        title.setBounds(50, 30, 400, 40);

        JLabel userLabel = new JLabel("Username");
        userLabel.setBounds(80, 100, 100, 30);

        JTextField username =
                new JTextField();

        username.setBounds(
                200, 100, 200, 30
        );

        JLabel passwordLabel =
                new JLabel("Password");

        passwordLabel.setBounds(
                80, 150, 100, 30
        );

        JPasswordField password =
                new JPasswordField();

        password.setBounds(
                200, 150, 200, 30
        );

        JLabel typeLabel =
                new JLabel("User Type");

        typeLabel.setBounds(
                80, 200, 100, 30
        );

        JComboBox<String> userType =
                new JComboBox<>(
                        new String[]{
                                "Administrator",
                                "Teacher"
                        }
                );

        userType.setBounds(
                200, 200, 200, 30
        );

        JButton login =
                new JButton("Login");

        login.setBounds(
                120, 270, 110, 40
        );

        JButton exit =
                new JButton("Exit");

        exit.setBounds(
                270, 270, 110, 40
        );

        mainPanel.add(title);
        mainPanel.add(userLabel);
        mainPanel.add(username);
        mainPanel.add(passwordLabel);
        mainPanel.add(password);
        mainPanel.add(typeLabel);
        mainPanel.add(userType);
        mainPanel.add(login);
        mainPanel.add(exit);

        login.addActionListener(e -> {

            String user =
                    username.getText().trim();

            String pass =
                    new String(
                            password.getPassword()
                    );

            String type =
                    (String) userType.getSelectedItem();

            if (type.equals("Administrator")) {

                // Administrator login
                if (user.equals("admin")
                        && pass.equals("admin123")) {

                    showAdminMenu();

                } else {

                    JOptionPane.showMessageDialog(
                            this,
                            "Invalid Administrator login"
                    );
                }

            } else {

                Teacher teacher =
                        findTeacher(user, pass);

                if (teacher != null) {

                    showTeacherMenu(
                            teacher.name
                    );

                } else {

                    JOptionPane.showMessageDialog(
                            this,
                            "Invalid Teacher login"
                    );
                }
            }
        });

        exit.addActionListener(
                e -> System.exit(0)
        );

        add(mainPanel);

        revalidate();
        repaint();
    }

    // ==============================
    // FIND TEACHER
    // ==============================

    private Teacher findTeacher(
            String username,
            String password) {

        for (Teacher teacher : teachers) {

            if (teacher.username.equals(username)
                    && teacher.password.equals(password)) {

                return teacher;
            }
        }

        return null;
    }

    // ==============================
    // ADMIN MENU
    // ==============================

